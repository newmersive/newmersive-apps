    },
    "android": {
      "package": "es.allwain.app",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF8"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "allwain.es",
              "pathPrefix": "/payment-return"
            },
            {
              "scheme": "https",
              "host": "allwain.es",
              "pathPrefix": "/connect-return"
            },
            {
              "scheme": "https",
              "host": "allwain.es",
              "pathPrefix": "/ofertas"
            },
            {
              "scheme": "https",
              "host": "allwain.es",
              "pathPrefix": "/perfil"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.20121163354-hb8c5ih4cjnn2s5nedh9nc3b82h2g0gk"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allwain usa la cámara para analizar productos, códigos y etiquetas dentro de la aplicación."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allwain usa únicamente la imagen que selecciones para extraer datos del producto.",
          "cameraPermission": "Allwain usa la cámara para analizar productos, códigos y etiquetas dentro de la aplicación."
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allwain usa tu ubicación precisa, cuando lo solicitas, para completar una dirección de entrega que puedes revisar y editar.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAF7",
          "image": "./assets/logos/Imagotipo_Allwain_01.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "livekit-react-native-webrtc"
            ]
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2feed82b-b654-4faf-ada6-c7793d354ad4"
      }
    },
    "owner": "newmersive"
  }
