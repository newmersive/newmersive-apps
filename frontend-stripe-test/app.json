{
  "expo": {
    "name": "Allwain",
    "slug": "allwain",
    "version": "1.0.2",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "orientation": "portrait",
    "scheme": "allwain",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "es.allwain.app",
      "buildNumber": "4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:allwain.es"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allwain usa la cámara para leer productos, códigos y etiquetas cuando creas una petición.",
        "NSMicrophoneUsageDescription": "Allwain usa el micrófono únicamente cuando decides participar en una videollamada.",
        "NSPhotoLibraryUsageDescription": "Allwain puede leer imágenes que selecciones para extraer datos de producto.",
        "NSLocationWhenInUseUsageDescription": "Allwain usa tu ubicación precisa, cuando lo solicitas, para completar una dirección de entrega que puedes revisar y editar."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
