generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String
  sponsorCode    String?  @unique
  referredByCode String?
  avatarUrl      String?
  tokens         Int?
  allwainBalance Float?
  createdAt      DateTime @default(now())
}

model Offer {
  id          String   @id @default(uuid())
  title       String
  description String
  owner       String
  ownerUserId String
  tokens      Int?
  price       Float?
  productId   String?
  meta        Json?
  createdAt   DateTime @default(now())
  isUnique    Boolean  @default(false)
}

model Trade {
  id         String    @id @default(uuid())
  offerId    String
  fromUserId String
  toUserId   String
  tokens     Int
  status     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Product {
  id          String  @id @default(uuid())
  name        String
  ean         String? @unique
  category    String?
  brand       String?
  description String?
  imageUrl    String?
  priceTokens Int?
}

model Lead {
  id        String   @id @default(uuid())
  name      String?
  email     String?
  phone     String?
  source    String
  message   String?
  offerId   String?
  userId    String?
  status    String
  createdAt DateTime @default(now())
  notes     String?
}

model LeadGlobal {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  channel   String
  sourceApp String
  name      String?
  phone     String?
  email     String?
  message   String
  status    String
  meta      Json?
}

model Contract {
  id            String   @id @default(uuid())
  app           String
  type          String
  status        String
  basePdfId     String?
  generatedText String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

model OrderGroup {
  id                String @id @default(uuid())
  productId         String
  totalUnits        Int
  minUnitsPerClient Int
  status            String
  participants      Json
}

model ReferralStat {
  id                  String @id @default(uuid())
  userId              String
  invitedUserId       String
  totalSavedByInvited Float
  commissionEarned    Float
  monthlyHistory      Json
}

model AllwainSavingTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  token     String @id
  userId    String
  expiresAt BigInt
}


// NEWMERSIVE Brain B01: additive foundations. No existing model is modified.
// Status and visibility values are constrained by the application layer in B01.2.
// Never expose private submissions through public challenge endpoints.
model BrainProfile {
  id             String   @id @default(uuid())
  userId         String?  @unique
  displayName    String
  contactEmail   String
  participantType String
  capabilities   Json?
  organization   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contributions  BrainContribution[]
  teamMemberships BrainTeamMember[]

  @@index([contactEmail])
}

model BrainChallenge {
  id            String   @id @default(uuid())
  projectKey    String
  title         String
  summary       String
  status        String   @default("DRAFT")
  visibility    String   @default("PRIVATE")
  informationLevel BrainInformationLevel @default(CONFIDENTIAL)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contributions BrainContribution[]

  @@index([projectKey, status, visibility])
}

model BrainContribution {
  id           String   @id @default(uuid())
  profileId    String
  challengeId  String?
  title        String
  description  String
  status       String   @default("SUBMITTED")
  informationLevel BrainInformationLevel @default(CONFIDENTIAL)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      BrainProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  challenge    BrainChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  reviews      BrainReview[]

  @@index([profileId, createdAt])
  @@index([challengeId, status])
}

model BrainReview {
  id             String   @id @default(uuid())
  contributionId String
  reviewerUserId String
  decision       String
  rationale      String
  createdAt      DateTime @default(now())
  contribution   BrainContribution @relation(fields: [contributionId], references: [id], onDelete: Restrict)

  @@index([contributionId, createdAt])
}

// B01.2 classification metadata does NOT grant model access to protected content.
// SECRET_ABSOLUTE assets must remain outside Brain's retrieval/storage perimeter.
enum BrainInformationLevel {
  PUBLIC
  RESTRICTED
  CONFIDENTIAL
  SECRET_ABSOLUTE
}

// An approved, sanitized derivative; never publish a raw confidential source.
model BrainPublication {
  id               String @id @default(uuid())
  projectKey       String
  title            String
  storageKey       String @unique
  sha256           String
  level            BrainInformationLevel @default(RESTRICTED)
  approvalStatus   String @default("PENDING")
  approvedByUserId String?
  approvedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime @default(now())
  grants           BrainAccessGrant[]

  @@index([projectKey, level, approvalStatus])
}

model BrainAccessGrant {
  id            String @id @default(uuid())
  publicationId String
  profileId     String
  grantedById   String
  grantedAt     DateTime @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  publication   BrainPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@index([profileId, revokedAt, expiresAt])
  @@unique([publicationId, profileId])
}

// Append-only behavior must be enforced by the application and DB permissions.
model BrainSecurityAuditEvent {
  id          String @id @default(uuid())
  actorId     String?
  action      String
  resourceType String
  resourceId  String
  outcome     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([resourceType, resourceId, createdAt])
}

 
// B01.3 collaboration. Membership does not itself authorize file access.
model BrainResearchTeam {
  id String @id @default(uuid())
  challengeId String?
  name String
  status String @default("DRAFT")
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members BrainTeamMember[]
  tasks BrainResearchTask[]
  @@index([challengeId, status])
}

model BrainTeamMember {
  id String @id @default(uuid())
  teamId String
  profileId String
  role String @default("CONTRIBUTOR")
  status String @default("INVITED")
  invitedAt DateTime @default(now())
  joinedAt DateTime?
  revokedAt DateTime?
  team BrainResearchTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  profile BrainProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  @@unique([teamId, profileId])
  @@index([profileId, status])
}

model BrainResearchTask {
  id String @id @default(uuid())
  teamId String
  assigneeId String?
  title String
  objective String
  status String @default("PROPOSED")
  informationLevel BrainInformationLevel @default(CONFIDENTIAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team BrainResearchTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  @@index([teamId, status])
  @@index([assigneeId, status])
}
