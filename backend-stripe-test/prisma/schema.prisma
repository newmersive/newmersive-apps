generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String    @id @default(uuid())
  name                      String
  email                     String    @unique
  passwordHash              String?
  role                      String
  sponsorCode               String?   @unique
  referredByCode            String?
  avatarUrl                 String?
  preferredLocale           String?
  analyticsConsent          Boolean?
  analyticsConsentVersion   String?
  analyticsConsentUpdatedAt DateTime?
  tokens                    Int?
  allwainBalance            Float?
  status                    String    @default("active")
  tokenVersion              Int       @default(0)
  emailVerifiedAt           DateTime?
  passwordChangedAt         DateTime?
  failedLoginCount          Int       @default(0)
  lastFailedLoginAt         DateTime?
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime  @default(now())
  deletedAt                 DateTime?

  authSessions AuthSession[]

  allwainFiscalProfiles              AllwainFiscalProfile[]
  allwainProductProfiles             AllwainProductComplianceProfile[]
  allwainPartySnapshots              AllwainPartySnapshot[]
  allwainOrderLinesSold              AllwainOrderLine[]
  allwainTransfersReceived           AllwainTransfer[]
  allwainDocumentsIssued             AllwainFiscalDocument[]           @relation("AllwainDocumentIssuer")
  allwainDocumentsReceived           AllwainFiscalDocument[]           @relation("AllwainDocumentRecipient")
  allwainProductLots                 AllwainProductLot[]
  allwainIncidentsReported           AllwainIncident[]                 @relation("AllwainIncidentReporter")
  allwainIncidentsAssigned           AllwainIncident[]                 @relation("AllwainIncidentAssignee")
  allwainConsentEvidence             AllwainConsentEvidence[]
  allwainReviewsAuthored             AllwainReview[]                   @relation("AllwainReviewAuthor")
  allwainReviewsReceived             AllwainReview[]                   @relation("AllwainReviewSubject")
  allwainReviewsModerated            AllwainReview[]                   @relation("AllwainReviewModerator")
  allwainReputation                  AllwainReputation?
  allwainRecallsOwned                AllwainProductRecall[]            @relation("AllwainRecallSeller")
  allwainRecallsIssued               AllwainProductRecall[]            @relation("AllwainRecallIssuer")
  allwainExperience                  AllwainExperienceProfile?
  allwainPublicationReviews          AllwainPublicationReview[]
  allwainShoppingLists               AllwainShoppingList[]             @relation("AllwainShoppingListBuyer")
  allwainShoppingListProposalItems   AllwainShoppingListProposalItem[] @relation("AllwainShoppingListProposalSeller")
  allwainEvidenceDocuments           AllwainEvidenceDocument[]         @relation("AllwainEvidenceOwner")
  allwainProposalRevisions           AllwainProposalRevision[]         @relation("AllwainProposalRevisionSeller")
  allwainExpectedDeliveryCheckpoints AllwainDeliveryCheckpoint[]       @relation("AllwainCheckpointExpectedUser")
  allwainVerifiedDeliveryCheckpoints AllwainDeliveryCheckpoint[]       @relation("AllwainCheckpointVerifier")
  allwainSupportTicketsRequested     AllwainSupportTicket[]            @relation("AllwainSupportRequester")
  allwainSupportTicketsAssigned      AllwainSupportTicket[]            @relation("AllwainSupportAssignee")
  allwainSupportMessagesAuthored     AllwainSupportMessage[]           @relation("AllwainSupportMessageAuthor")
  allwainSupportControlsUpdated      AllwainSupportControl[]           @relation("AllwainSupportControlUpdater")
  allwainAppTesterProgress           AllwainAppTesterProgress[]
  trueqiaTesterActions               TrueqiaTesterAction[]
  trueqiaTesterIncidents             TrueqiaTesterIncident[]
  allwainAppTesterActionProgress     AllwainAppTesterActionProgress[]

  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([lockedUntil])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  sourceApp        String
  userAgentHash    String?
  ipHash           String?
  tokenVersion     Int
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?
  rotatedFromId    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model AuthIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  email           String
  emailVerified   Boolean  @default(false)
  profile         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([email])
}

model AuthLoginChallenge {
  id            String    @id @default(uuid())
  provider      String
  challengeHash String    @unique
  sourceApp     String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([provider, sourceApp, expiresAt])
}

model AllwainBuyerProfile {
  userId                 String   @id
  status                 String   @default("active")
  defaultFiscalProfileId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status, updatedAt])
}

model AllwainSellerProfile {
  userId                 String    @id
  status                 String    @default("not_activated")
  commercialModel        String    @default("marketplace")
  sellerType             String?
  displayName            String?
  fiscalStatus           String    @default("not_started")
  defaultFiscalProfileId String?
  locationLabel          String?
  pickupAddress          String?
  shippingPostalCode     String?
  shippingCity           String?
  shippingCountryCode    String?   @default("ES")
  shippingPhone          String?
  locationLatApprox      Float?
  locationLngApprox      Float?
  activatedAt            DateTime?
  verifiedAt             DateTime?
  restrictedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([commercialModel, status])
}

model AllwainConnectorProfile {
  userId            String    @id
  status            String    @default("not_activated")
  available         Boolean   @default(false)
  radiusKm          Int       @default(5)
  locationLabel     String?
  locationLatApprox Float?
  locationLngApprox Float?
  activatedAt       DateTime?
  restrictedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, available, radiusKm])
}

model AllwainExperienceProfile {
  userId                String    @id
  onboardingVersion     Int       @default(0)
  onboardingCompletedAt DateTime?
  primaryIntent         String?
  guidanceEnabled       Boolean   @default(true)
  lastContext           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([onboardingVersion, updatedAt])
}

model AllwainAppTesterProgress {
  id              String   @id @default(uuid())
  userId          String
  programId       String
  stepId          String
  status          String   @default("completed")
  platform        String   @default("unknown")
  appVersion      String?
  clientReference String
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId, stepId])
  @@index([userId, programId, updatedAt])
  @@index([programId, stepId, status])
}

model AllwainAppTesterActionProgress {
  id              String    @id @default(uuid())
  userId          String
  programId       String
  stepId          String
  actionId        String
  status          String    @default("pending")
  platform        String    @default("unknown")
  appVersion      String?
  clientReference String
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId, stepId, actionId])
  @@index([userId, programId, updatedAt])
  @@index([programId, stepId, actionId, status])
}

model AllwainPublicationReview {
  id          String    @id @default(uuid())
  userId      String
  entityType  String
  entityId    String?
  draftHash   String
  decision    String
  score       Int
  summary     String
  issues      Json
  suggestions Json
  normalized  Json?
  provider    String    @default("rules")
  model       String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([decision, createdAt])
  @@index([draftHash, createdAt])
}

model CourseEntitlement {
  id          String    @id @default(uuid())
  userId      String
  email       String
  product     String
  entitlement String
  source      String
  metadata    Json?
  expiresAt   DateTime?
  revokedAt   DateTime?
  grantedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, entitlement])
  @@index([email])
  @@index([product, entitlement])
}

model CourseProgress {
  id           String    @id @default(uuid())
  userId       String
  moduleId     Int
  lessonIndex  Int       @default(0)
  status       String    @default("not_started")
  percent      Int       @default(0)
  studentState Json?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, moduleId])
  @@index([userId, updatedAt])
}

model CourseSubmission {
  id           String    @id @default(uuid())
  userId       String
  moduleId     Int
  artifactType String
  fileName     String?
  storedName   String?
  mimeType     String?
  sizeBytes    Int?
  textContent  String?
  status       String    @default("submitted")
  aiReview     Json?
  adminNotes   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CourseAiMessage {
  id        String   @id @default(uuid())
  userId    String
  agent     String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CourseConsent {
  id         String   @id @default(uuid())
  userId     String
  type       String
  version    String
  acceptedAt DateTime @default(now())
  ipHash     String?

  @@unique([userId, type, version])
  @@index([userId, acceptedAt])
}

model CourseAuditEvent {
  id           String   @id @default(uuid())
  actorUserId  String?
  targetUserId String?
  action       String
  metadata     Json?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model CourseEmailDelivery {
  id        String    @id @default(uuid())
  userId    String?
  email     String
  template  String
  status    String
  provider  String?
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([email, createdAt])
  @@index([status, createdAt])
}

model CoursePaymentEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique
  type            String
  status          String    @default("processing")
  error           String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model CoursePayment {
  id                String   @id @default(uuid())
  provider          String   @default("stripe")
  checkoutSessionId String   @unique
  paymentIntentId   String?
  userId            String?
  email             String
  plan              String
  entitlement       String
  status            String
  amountTotal       Int?
  currency          String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentIntentId])
  @@index([email, createdAt])
  @@index([status, createdAt])
}

model CourseCertificate {
  id               String    @id @default(uuid())
  userId           String    @unique
  verificationCode String    @unique
  studentName      String
  courseName       String
  metadata         Json?
  issuedAt         DateTime  @default(now())
  revokedAt        DateTime?

  @@index([issuedAt])
}

model CourseSupportTicket {
  id         String    @id @default(uuid())
  userId     String
  category   String
  subject    String
  message    String
  status     String    @default("open")
  priority   String    @default("normal")
  aiTriage   Json?
  adminNotes String?
  assignedTo String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, priority, createdAt])
}

model CourseAnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([name, createdAt])
}

model AllwainShoppingList {
  id                       String    @id @default(uuid())
  buyerUserId              String
  sourceShoppingListId     String?
  sourceEvidenceDocumentId String?
  sourceOcrExtractionId    String?
  sourceKind               String    @default("manual")
  title                    String
  description              String?
  demo                     Boolean   @default(false)
  status                   String    @default("draft")
  visibility               String    @default("private")
  currency                 String    @default("EUR")
  allowSubstitutions       Boolean   @default(false)
  needByText               String?
  proposalDeadlineAt       DateTime?
  preferredDeliveryChannel String?
  deliveryAddress          Json?
  deliveryWindow           Json?
  recurrence               Json?
  locationLabel            String?
  locationLatApprox        Float?
  locationLngApprox        Float?
  selectedOfferId          String?   @unique
  selectedAt               DateTime?
  publishedAt              DateTime?
  closedAt                 DateTime?
  version                  Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  buyer               User                              @relation("AllwainShoppingListBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  items               AllwainShoppingListItem[]
  offers              Offer[]                           @relation("AllwainShoppingListOffers")
  contracts           Contract[]                        @relation("AllwainShoppingListContracts")
  orders              AllwainOrder[]                    @relation("AllwainShoppingListOrders")
  recurringPlans      AllwainRecurringPlan[]            @relation("AllwainShoppingListRecurringPlans")
  proposalItems       AllwainShoppingListProposalItem[]
  selectedOffer       Offer?                            @relation("AllwainShoppingListSelectedOffer", fields: [selectedOfferId], references: [id], onDelete: Restrict)
  sourceShoppingList  AllwainShoppingList?              @relation("AllwainShoppingListCopies", fields: [sourceShoppingListId], references: [id], onDelete: Restrict)
  copies              AllwainShoppingList[]             @relation("AllwainShoppingListCopies")
  sourceEvidence      AllwainEvidenceDocument?          @relation("AllwainEvidenceShoppingLists", fields: [sourceEvidenceDocumentId], references: [id], onDelete: Restrict)
  sourceOcrExtraction AllwainOcrExtraction?             @relation("AllwainExtractionShoppingLists", fields: [sourceOcrExtractionId], references: [id], onDelete: Restrict)

  @@index([buyerUserId, status, updatedAt])
  @@index([sourceShoppingListId, createdAt])
  @@index([sourceEvidenceDocumentId, createdAt])
  @@index([sourceOcrExtractionId])
  @@index([visibility, status, publishedAt])
  @@index([proposalDeadlineAt, status])
  @@index([locationLabel, status])
}

model AllwainShoppingListItem {
  id                    String    @id @default(uuid())
  shoppingListId        String
  position              Int
  productName           String
  description           String?
  quantity              Decimal   @db.Decimal(18, 3)
  unit                  String
  targetUnitPriceAmount Int?
  reviewStatus          String    @default("selected")
  referencePriceSource  String    @default("manual")
  referencePriceLocked  Boolean   @default(false)
  referenceCapturedAt   DateTime?
  referenceDocumentId   String?
  ocrLineItemId         String?   @unique
  category              String?
  subcategory           String?
  productKind           String?
  notes                 String?
  qualityReviewId       String?
  qualityDecision       String?
  qualityScore          Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shoppingList      AllwainShoppingList               @relation(fields: [shoppingListId], references: [id], onDelete: Restrict)
  proposalItems     AllwainShoppingListProposalItem[]
  orderLines        AllwainOrderLine[]
  referenceDocument AllwainEvidenceDocument?          @relation("AllwainEvidenceShoppingListItems", fields: [referenceDocumentId], references: [id], onDelete: Restrict)
  ocrLineItem       AllwainOcrLineItem?               @relation(fields: [ocrLineItemId], references: [id], onDelete: Restrict)

  @@unique([shoppingListId, position])
  @@index([shoppingListId, productKind, category])
  @@index([shoppingListId, reviewStatus, position])
  @@index([referenceDocumentId])
  @@index([productName])
}

model AllwainShoppingListProposalItem {
  id                 String   @id @default(uuid())
  shoppingListId     String
  shoppingListItemId String
  offerId            String
  sellerUserId       String
  position           Int
  productName        String
  description        String?
  quantity           Decimal  @db.Decimal(18, 3)
  unit               String
  unitPriceAmount    Int
  subtotalAmount     Int
  currency           String
  isSubstitution     Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shoppingList     AllwainShoppingList     @relation(fields: [shoppingListId], references: [id], onDelete: Restrict)
  shoppingListItem AllwainShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Restrict)
  offer            Offer                   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  seller           User                    @relation("AllwainShoppingListProposalSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  orderLines       AllwainOrderLine[]

  @@unique([offerId, shoppingListItemId])
  @@index([shoppingListId, sellerUserId])
  @@index([shoppingListItemId])
  @@index([offerId, position])
}

model AllwainEvidenceDocument {
  id               String    @id @default(uuid())
  ownerUserId      String
  sourceType       String
  documentType     String
  status           String    @default("active")
  mimeType         String?
  storageKey       String?
  byteSize         Int?
  contentHash      String
  rawTextHash      String?
  originalFileName String?
  supersededById   String?
  capturedAt       DateTime  @default(now())
  annulledAt       DateTime?
  annulmentReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner             User                      @relation("AllwainEvidenceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  extractions       AllwainOcrExtraction[]
  scanRequests      AllwainScanRequest[]      @relation("AllwainEvidenceScanRequests")
  shoppingLists     AllwainShoppingList[]     @relation("AllwainEvidenceShoppingLists")
  shoppingListItems AllwainShoppingListItem[] @relation("AllwainEvidenceShoppingListItems")
  supersededBy      AllwainEvidenceDocument?  @relation("AllwainEvidenceSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes        AllwainEvidenceDocument[] @relation("AllwainEvidenceSupersession")

  @@index([ownerUserId, status, createdAt])
  @@index([ownerUserId, contentHash, status])
  @@index([supersededById])
}

model AllwainOcrExtraction {
  id                 String   @id @default(uuid())
  evidenceDocumentId String
  version            Int      @default(1)
  provider           String
  model              String
  status             String   @default("captured")
  rawText            String?
  rawData            Json?
  confidence         Float?
  extractionHash     String
  createdAt          DateTime @default(now())

  evidenceDocument AllwainEvidenceDocument @relation(fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  lineItems        AllwainOcrLineItem[]
  scanRequests     AllwainScanRequest[]    @relation("AllwainExtractionScanRequests")
  shoppingLists    AllwainShoppingList[]   @relation("AllwainExtractionShoppingLists")

  @@unique([evidenceDocumentId, version])
  @@index([evidenceDocumentId, status, createdAt])
  @@index([extractionHash])
}

model AllwainOcrLineItem {
  id              String   @id @default(uuid())
  extractionId    String
  position        Int
  rawText         String
  productName     String
  description     String?
  quantity        Decimal  @db.Decimal(18, 3)
  unit            String
  unitPriceAmount Int
  lineTotalAmount Int
  currency        String
  confidence      Float
  taxIncluded     Boolean?
  discountAmount  Int?
  reviewStatus    String   @default("selected")
  createdAt       DateTime @default(now())

  extraction       AllwainOcrExtraction     @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  shoppingListItem AllwainShoppingListItem?

  @@unique([extractionId, position])
  @@index([extractionId, reviewStatus, position])
}

model Offer {
  id                String    @id @default(uuid())
  title             String
  description       String
  owner             String
  ownerUserId       String
  tokens            Int?
  price             Float?
  productId         String?
  meta              Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  isUnique          Boolean   @default(false)
  allwainType       String?
  allwainStatus     String?
  requestId         String?
  shoppingListId    String?
  currency          String?
  unit              String?
  category          String?
  subcategory       String?
  productKind       String?
  locationLabel     String?
  commercialModel   String    @default("marketplace")
  proposalExpiresAt DateTime?
  proposalRevision  Int       @default(0)

  allwainProductCompliance  AllwainProductComplianceProfile?
  allwainOrderLines         AllwainOrderLine[]
  allwainProductLots        AllwainProductLot[]
  shoppingList              AllwainShoppingList?              @relation("AllwainShoppingListOffers", fields: [shoppingListId], references: [id], onDelete: Restrict)
  shoppingListProposalItems AllwainShoppingListProposalItem[]
  selectedForShoppingList   AllwainShoppingList?              @relation("AllwainShoppingListSelectedOffer")
  proposalRevisions         AllwainProposalRevision[]

  @@unique([shoppingListId, ownerUserId])
  @@index([owner, allwainType, allwainStatus, createdAt])
  @@index([ownerUserId, allwainStatus, createdAt])
  @@index([requestId, allwainStatus, createdAt])
  @@index([shoppingListId, allwainStatus, createdAt])
  @@index([category, subcategory, createdAt])
  @@index([productKind, createdAt])
  @@index([currency, createdAt])
  @@index([commercialModel, productKind, createdAt])
  @@index([proposalExpiresAt, allwainStatus])
}

model AllwainProposalRevision {
  id                 String    @id @default(uuid())
  offerId            String
  revision           Int
  sellerUserId       String
  requestId          String?
  shoppingListId     String?
  totalAmount        Int
  referenceAmount    Int?
  grossSavingsAmount Int?
  currency           String
  validUntil         DateTime
  description        String
  deliveryEstimate   String
  payload            Json
  snapshotHash       String
  status             String    @default("current")
  acceptedAt         DateTime?
  createdAt          DateTime  @default(now())

  offer             Offer              @relation(fields: [offerId], references: [id], onDelete: Restrict)
  seller            User               @relation("AllwainProposalRevisionSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  acceptedContracts Contract[]         @relation("AllwainAcceptedContractRevision")
  acceptedOrders    AllwainOrder[]     @relation("AllwainAcceptedOrderRevision")
  orderLines        AllwainOrderLine[]

  @@unique([offerId, revision])
  @@index([requestId, status, validUntil])
  @@index([shoppingListId, status, validUntil])
  @@index([sellerUserId, createdAt])
}

model Trade {
  id                  String    @id @default(uuid())
  offerId             String
  fromUserId          String
  toUserId            String
  tokens              Int
  status              String
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?
  startedAt           DateTime?
  tokensTransferredAt DateTime?
  fromCompletedAt     DateTime?
  toCompletedAt       DateTime?
  completedAt         DateTime?
  trueqiaDetails      Json?

  @@index([status, createdAt])
  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@index([offerId, status])
}

model TrueqiaProfile {
  userId    String   @id
  payload   Json
  updatedAt DateTime @default(now()) @updatedAt
}

model TrueqiaTesterAction {
  id          String   @id
  userId      String
  programId   String
  stepId      String
  actionId    String
  platform    String
  appVersion  String?
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, programId, stepId, actionId])
}

model TrueqiaTesterIncident {
  id              String   @id
  userId          String
  programId       String
  clientReference String
  contentHash     String
  payload         Json
  status          String   @default("open")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, programId, clientReference])
  @@index([userId, programId, createdAt])
}

model TrueqiaNeed {
  id            String   @id
  userId        String
  title         String
  description   String
  category      String
  mode          String
  locationLabel String
  availability  String
