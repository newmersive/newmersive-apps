+
+module.exports = { setup, proposal };
+
+if (require.main === module) {
+describe("Pass 2 seller proposal lifecycle", () => {
+  for (const driver of ["json", "postgres"]) {
+    it(`withdraws only own proposal and is idempotent (${driver})`, async () => {
