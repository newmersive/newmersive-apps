+export function demandFilterSummary(locale: AppLocale, query: DiscoveryQuery) {
+  const c = demandFilterCopy[locale];
+  const summary: string[] = [];
+  if (query.responseStatus) summary.push(`${c.response}: ${c[query.responseStatus as keyof DemandCopy] || query.responseStatus}`);
+  if (query.deliveryChannel) summary.push(`${c.channel}: ${c[query.deliveryChannel as keyof DemandCopy] || query.deliveryChannel}`);
+  if (query.proposalDeadlineBefore || query.proposalDeadlineAfter) summary.push(`${c.deadline}: ${query.proposalDeadlineAfter || "…"} → ${query.proposalDeadlineBefore || "…"}`);
+  return summary;
+}
