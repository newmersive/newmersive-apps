+  const offers = await tx.$queryRaw(Prisma.sql`SELECT * FROM "Offer" WHERE "owner" = 'allwain' AND COALESCE("requestId", "meta"->>'requestId') = ${request.id} ORDER BY "id" ASC FOR UPDATE`);
