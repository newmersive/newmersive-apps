+        // native secure storage cannot enumerate any keys it may have named.
+        if (indexReadable) {
+          if (failed.length) await storage.setItem(indexKey(userId), JSON.stringify(failed));
+          else await storage.removeItem(indexKey(userId));
+        }
+      } catch { cleared = false; }
+      return cleared;
