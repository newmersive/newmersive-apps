+  return {
+    selectedItems: Object.fromEntries(list.items.map(item => [item.id, item.availabilityStatus !== "awarded" && item.availabilityStatus !== "discarded" && item.reviewStatus !== "discarded" && (existing.size ? existing.has(item.id) : true)])),
